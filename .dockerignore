# Keep the build context small and the image free of host artifacts.

# VCS / editors / agent scaffolding
.git
.gitignore
.github
.idea
.vscode
.claude

# Docs & planning (never needed at build or runtime)
planning
README.md
LICENSE
CLAUDE.md

# Secrets — the container gets these via --env-file at RUN time, never baked in
.env
.env.*
!.env.example

# Runtime database (bind-mounted at /app/data)
data/*.db
data/*.db-wal
data/*.db-shm

# Tests (E2E runs from the host — CONTRACTS.md §16)
test
backend/tests
frontend/tests
frontend/e2e
playwright-report
test-results

# Python build/runtime junk
__pycache__
**/__pycache__
*.py[cod]
.venv
**/.venv
.pytest_cache
**/.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
*.egg-info

# Node build/runtime junk
node_modules
**/node_modules
.next
**/.next
out
**/out
npm-debug.log*
.npm

# Docker / scripts (not consumed by the build)
Dockerfile
.dockerignore
docker-compose.yml
scripts

# OS noise
.DS_Store
Thumbs.db
