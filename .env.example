# ---------------------------------------------------------------------------
# FinAlly — environment configuration
#
# This is the first file you touch. Copy it and you are done:
#
#     cp .env.example .env
#
# You do NOT need any API keys to run FinAlly. With everything left empty the
# app runs fully on the built-in market simulator; only the AI chat panel is
# disabled. The start scripts create .env from this file automatically if it
# is missing.
#
# .env is gitignored. Never commit real keys.
#
# NOTE ON FORMAT: this file is passed straight to Docker via --env-file, which
# does NOT strip trailing comments. `KEY=value  # note` would set the value to
# "value  # note". So every comment here lives on its own line. Keep it that
# way, and do not quote values.
# ---------------------------------------------------------------------------


# --- AI chat -----------------------------------------------------------------
# OpenRouter API key. Required only for the live AI chat assistant.
# Empty -> chat is disabled and the rest of the app works normally.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Deterministic mock LLM responses instead of calling OpenRouter.
# Used by the E2E suite; also handy for developing without a key.
# true | false
LLM_MOCK=false


# --- Market data -------------------------------------------------------------
# Massive (Polygon.io) API key for real market data.
# Empty -> the built-in GBM simulator is used. This is the default and is
# recommended for most users.
MASSIVE_API_KEY=

# Freeze the simulator at its seed prices so prices never move.
# Only useful for deterministic end-to-end tests.
# true | false
SIM_FIXED_PRICES=false

# How old a quote may be before trades against it are rejected.
# Empty -> 10 seconds in simulator mode, 90 seconds in Massive mode.
QUOTE_MAX_AGE_SECONDS=


# --- Runtime -----------------------------------------------------------------
# Where the SQLite database file lives.
# Local development (running from the repo root): ./data/finally.db
# In Docker this is overridden to /app/data/finally.db, which is bind-mounted
# to ./data on your machine — so the file is the same one either way, and you
# can inspect or delete it directly.
DATABASE_PATH=./data/finally.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
